<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- 개인용 가사 캐시 서버. Musebase.Core만 참조한다 — 코디네이터·재생 소스는 필요 없고,
       키 정규화(LyricsCacheStore.MakeKey)·LRC 파싱을 클라이언트와 같은 코드로 계산하기 위해서다.
       배포는 Oracle(ARM64) + systemd + tailscale serve — deploy/README.md 참고. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Musebase.Server</RootNamespace>
    <!-- 단일 파일 self-contained 배포에서 SQLite provider·STJ 리플렉션이 깨지지 않도록 트리밍은 끈다. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Musebase.Core\Musebase.Core.csproj" />
  </ItemGroup>

</Project>
