[Unit]
Description=Musebase lyrics cache server
# tailscaled 이후에 뜨게 한다 — 노출은 `tailscale serve`가 담당한다.
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=musebase
WorkingDirectory=/opt/musebase
ExecStart=/opt/musebase/Musebase.Server
# MUSEBASE_TOKEN=..., MUSEBASE_DB=/var/lib/musebase/lyrics.db (chmod 600, root 소유)
EnvironmentFile=/etc/musebase/server.env
# 루프백만 리슨한다. 외부에서 오는 트래픽은 전부 tailscale serve를 거친다(공격면 0).
Environment=ASPNETCORE_URLS=http://127.0.0.1:5180
Restart=always
RestartSec=5

# 최소 권한
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/musebase

[Install]
WantedBy=multi-user.target
